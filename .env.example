# ─────────────────────────────────────────────
# Cascade Apartment 3 — Vercel Environment Variables
# Copy this file to .env.local for local dev.
# Set these in the Vercel dashboard under
# Project → Settings → Environment Variables.
# ─────────────────────────────────────────────

# Resend email API key — https://resend.com
# Free tier: 3,000 emails/month, 100/day
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The "from" address for outgoing emails.
# Must match a domain you've verified in Resend.
# For testing you can use: onboarding@resend.dev
EMAIL_FROM=hello@mtbawbawcascade3.com

# Admin inbox — where new-booking alerts and contact form enquiries go
ADMIN_EMAIL=hello@mtbawbawcascade3.com

# ─────────────────────────────────────────────
# Stripe Payment Processing
# Get these from: https://dashboard.stripe.com/apikeys
# Use test keys (pk_test_ / sk_test_) for development
# Switch to live keys (pk_live_ / sk_live_) for production
# ─────────────────────────────────────────────
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# ─────────────────────────────────────────────
# Vercel Postgres — server-side rate persistence
# Created under: Vercel Dashboard → Storage → Create Postgres Database
# Link the database to this project; Vercel auto-adds the vars below.
# Without these set, /api/rates still works but rates reset to defaults
# on every deployment (no server-side persistence).
# ─────────────────────────────────────────────
POSTGRES_URL=postgres://user:password@host/dbname
POSTGRES_URL_NON_POOLING=postgres://user:password@host/dbname?sslmode=require

# ─────────────────────────────────────────────
# Admin Authentication
# Set these in the Vercel dashboard under
# Project → Settings → Environment Variables.
# ─────────────────────────────────────────────

# Password for the admin account (hello@mtbawbawcascade3.com)
ADMIN_PASSWORD=change-me-strong-password

# Password for the owner account (typhoon.tall69@gmail.com)
OWNER_PASSWORD=change-me-strong-password

# Random secret used to sign session tokens — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-random-64-hex-chars
